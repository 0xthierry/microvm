# Restore the netfilter pieces that Docker needs inside the guest.
#
# Firecracker's default guest configs disable the raw tables explicitly, and
# they also keep nf_tables disabled. Our Ubuntu 24.04 guest userspace uses the
# iptables-nft backend by default, so Docker bridge setup needs both the legacy
# raw tables and the nftables kernel family.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NF_CT_NETLINK=y
